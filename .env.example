NEXT_PUBLIC_POLYGON_CHAIN_ID=137
NEXT_PUBLIC_ISIO_TOKEN_ADDRESS=
NEXT_PUBLIC_POLYGON_RPC_URL=

# App deployment label only: development or production.
# LI.FI does not provide an isolated sandbox/testnet API; both modes use its live API.
NEXT_PUBLIC_DEPLOYMENT_ENV=development

# Optional LI.FI API key. Configure separately in each deployment's server environment.
# Never add NEXT_PUBLIC_ to this secret or commit a real key.
LI_FI_API_KEY=
