NEXT_PUBLIC_POLYGON_CHAIN_ID=137
NEXT_PUBLIC_ISIO_TOKEN_ADDRESS=
NEXT_PUBLIC_POLYGON_RPC_URL=

# Application label. LI.FI calls use its live API in every mode; there is no sandbox endpoint.
# Set to development for local work, production for the deployed live app.
NEXT_PUBLIC_DEPLOYMENT_ENV=production

# Display-only reference target; this does not set or guarantee a market peg.
NEXT_PUBLIC_ISIOLO_PRICE_USD=17

# Optional LI.FI API key. Configure separately as a server-side deployment secret.
# Never add NEXT_PUBLIC_ to this secret or commit a real key.
LI_FI_API_KEY=
